# secrets/.templates/services/tududi.yaml.j2 – tududi app-local secrets
# Encrypted to: oci-melb-1 (tududi host)
# Key path: secrets/services/tududi.yaml
# The OIDC client secret is not here: it lives with the other oci-melb-1 client
# secrets in secrets/hosts/oci-melb-1/oidc.yaml.
#
# Bootstrap: just secrets bootstrap secrets/services/tududi.yaml
# The admin password and session secret are generated. The bootstrap admin's
# address is operator-issued: export TUDUDI_ADMIN_EMAIL at bootstrap, or set it
# afterwards with
#   sops set secrets/services/tududi.yaml '["tududi"]["admin_email"]' '"you@example.com"'
# Upstream creates the admin only when this and the password are both set, so an
# empty value leaves password login without an account (Kanidm still works).
tududi:
  admin_email: "{{ environ.TUDUDI_ADMIN_EMAIL | default('') }}"
  admin_password: "{{ secrets.token_hex(24) }}"
  session_secret: "{{ secrets.token_hex(32) }}"
