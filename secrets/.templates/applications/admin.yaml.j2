# secrets/.templates/applications/admin.yaml.j2 – admin stack secrets
# Encrypted to: la-admin-1 (admin stack host)
# Key path: secrets/applications/admin.yaml
#
# Bootstrap: just secrets bootstrap secrets/applications/admin.yaml
# Supply:    BOOTSTRAP_HOMEPAGE_TAILSCALE_DEVICE_ID — Tailscale device id for the homepage widget.
# Supply:    BOOTSTRAP_HOMEPAGE_TAILSCALE_API_KEY — Tailscale API key for the homepage widget.
# Supply:    BOOTSTRAP_HOMEPAGE_NAVIDROME_USER — Navidrome username for the homepage widget.
# Supply:    BOOTSTRAP_HOMEPAGE_NAVIDROME_TOKEN — Navidrome API token for the homepage widget.
# Supply:    BOOTSTRAP_HOMEPAGE_NAVIDROME_SALT — Navidrome token salt for the homepage widget.
# Supply:    BOOTSTRAP_HOMEPAGE_SLSKD_KEY — slskd API key for the homepage widget.
# Supply:    BOOTSTRAP_HOMEPAGE_BESZEL_USERNAME — Beszel hub username for the homepage widget.
# Supply:    BOOTSTRAP_HOMEPAGE_BESZEL_PASSWORD — Beszel hub password for the homepage widget.
# Supply:    BOOTSTRAP_VAULTWARDEN_ADMIN_TOKEN — Vaultwarden admin token.
# Supply:    BOOTSTRAP_VAULTWARDEN_SMTP_USERNAME — Vaultwarden SMTP username.
# Supply:    BOOTSTRAP_VAULTWARDEN_SMTP_PASSWORD — Vaultwarden SMTP password.
# Supply:    BOOTSTRAP_VAULTWARDEN_PUSH_INSTALLATION_ID — Vaultwarden push installation id.
# Supply:    BOOTSTRAP_VAULTWARDEN_PUSH_INSTALLATION_KEY — Vaultwarden push installation key.
homepage:
  tailscale:
    device_id: "{{ environ.BOOTSTRAP_HOMEPAGE_TAILSCALE_DEVICE_ID | default('PLACEHOLDER') }}"
    api_key: "{{ environ.BOOTSTRAP_HOMEPAGE_TAILSCALE_API_KEY | default('PLACEHOLDER') }}"
  navidrome:
    user: "{{ environ.BOOTSTRAP_HOMEPAGE_NAVIDROME_USER | default('PLACEHOLDER') }}"
    token: "{{ environ.BOOTSTRAP_HOMEPAGE_NAVIDROME_TOKEN | default('PLACEHOLDER') }}"
    salt: "{{ environ.BOOTSTRAP_HOMEPAGE_NAVIDROME_SALT | default('PLACEHOLDER') }}"
  slskd:
    key: "{{ environ.BOOTSTRAP_HOMEPAGE_SLSKD_KEY | default('PLACEHOLDER') }}"
  beszel:
    username: "{{ environ.BOOTSTRAP_HOMEPAGE_BESZEL_USERNAME | default('PLACEHOLDER') }}"
    password: "{{ environ.BOOTSTRAP_HOMEPAGE_BESZEL_PASSWORD | default('PLACEHOLDER') }}"
vaultwarden:
  admin_token: "{{ environ.BOOTSTRAP_VAULTWARDEN_ADMIN_TOKEN | default('PLACEHOLDER') }}"
  smtp_username: "{{ environ.BOOTSTRAP_VAULTWARDEN_SMTP_USERNAME | default('PLACEHOLDER') }}"
  smtp_password: "{{ environ.BOOTSTRAP_VAULTWARDEN_SMTP_PASSWORD | default('PLACEHOLDER') }}"
  push_installation_id: "{{ environ.BOOTSTRAP_VAULTWARDEN_PUSH_INSTALLATION_ID | default('PLACEHOLDER') }}"
  push_installation_key: "{{ environ.BOOTSTRAP_VAULTWARDEN_PUSH_INSTALLATION_KEY | default('PLACEHOLDER') }}"
