          "editorMode": "code",
          "expr": "node_load1{host=~\"$host\"}",
          "legendFormat": "{{host}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
