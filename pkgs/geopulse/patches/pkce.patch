+package org.github.tess1o.geopulse.auth.oidc.service;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.nimbusds.jose.JWSAlgorithm;
+import com.nimbusds.jose.JWSHeader;
+import com.nimbusds.jose.crypto.RSASSASigner;
+import com.nimbusds.jose.jwk.JWKSet;
+import com.nimbusds.jose.jwk.RSAKey;
+import com.nimbusds.jwt.JWTClaimsSet;
+import com.nimbusds.jwt.SignedJWT;
+import com.sun.net.httpserver.HttpExchange;
+import com.sun.net.httpserver.HttpServer;
+import io.quarkus.test.common.QuarkusTestResourceLifecycleManager;
+
+import java.io.IOException;
+import java.io.OutputStream;
+import java.net.InetSocketAddress;
+import java.net.URLDecoder;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.Base64;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * In-process stand-in for the Kanidm provider. It serves discovery, JWKS, and a token endpoint
+ * that enforces PKCE the way Kanidm does for a confidential client: the S256 challenge recorded at
+ * authorization must match the verifier presented at the token exchange.
+ */
+public class FakeOidcProviderResource implements QuarkusTestResourceLifecycleManager {
+
+    static final String PROVIDER = "fake";
+    static final String CLIENT_ID = "geopulse-test";
+    static final String CLIENT_SECRET = "test-secret";
+    static final String USER_EMAIL = "pkce-user@example.test";
+
+    private static final ObjectMapper JSON = new ObjectMapper();
+    private static final String KID = "test-key";
+
+    private static HttpServer server;
+    private static String baseUrl;
+    private static RSAKey signingKey;
+    private static final Map<String, Grant> grants = new ConcurrentHashMap<>();
+
+    /** An authorization the fake issued, bound to the challenge and nonce the login sent. */
+    private record Grant(String challenge, String nonce) {}
+
+    @Override
+    public Map<String, String> start() {
+        try {
+            var pair = generatePair();
+            signingKey = new RSAKey.Builder((java.security.interfaces.RSAPublicKey) pair.getPublic())
+                    .privateKey(pair.getPrivate())
+                    .keyID(KID)
+                    .build();
+            server = HttpServer.create(new InetSocketAddress("127.0.0.1", 0), 0);
+            server.createContext("/.well-known/openid-configuration", this::discovery);
+            server.createContext("/jwks", this::jwks);
+            server.createContext("/token", this::token);
+            server.start();
+            baseUrl = "http://127.0.0.1:" + server.getAddress().getPort();
+        } catch (Exception e) {
+            throw new IllegalStateException("Failed to start fake provider", e);
+        }
+        Map<String, String> config = new HashMap<>();
+        config.put("geopulse.oidc.provider." + PROVIDER + ".enabled", "true");
+        config.put("geopulse.oidc.provider." + PROVIDER + ".client-id", CLIENT_ID);
+        config.put("geopulse.oidc.provider." + PROVIDER + ".client-secret", CLIENT_SECRET);
+        config.put("geopulse.oidc.provider." + PROVIDER + ".discovery-url", baseUrl + "/.well-known/openid-configuration");
+        return config;
+    }
+
+    @Override
+    public void stop() {
+        if (server != null) {
+            server.stop(0);
+        }
+    }
+
+    /** Plays the browser's part: the provider records the challenge and nonce, then issues a code. */
+    static String authorize(String authorizationUrl) {
+        Map<String, String> query = query(authorizationUrl);
+        String code = UUID.randomUUID().toString();
+        grants.put(code, new Grant(query.get("code_challenge"), query.get("nonce")));
+        return code;
+    }
+
+    static String challengeMethod(String authorizationUrl) {
+        return query(authorizationUrl).get("code_challenge_method");
+    }
+
+    private void discovery(HttpExchange exchange) throws IOException {
+        Map<String, Object> document = Map.of(
+                "issuer", baseUrl,
+                "authorization_endpoint", baseUrl + "/authorize",
+                "token_endpoint", baseUrl + "/token",
+                "userinfo_endpoint", baseUrl + "/userinfo",
+                "jwks_uri", baseUrl + "/jwks");
+        respond(exchange, 200, JSON.writeValueAsBytes(document));
+    }
+
+    private void jwks(HttpExchange exchange) throws IOException {
+        respond(exchange, 200, JSON.writeValueAsBytes(new JWKSet(signingKey.toPublicJWK()).toJSONObject()));
+    }
+
+    private void token(HttpExchange exchange) throws IOException {
+        Map<String, String> form = query(new String(exchange.getRequestBody().readAllBytes(), StandardCharsets.UTF_8));
+        Grant grant = grants.remove(form.get("code"));
+        if (grant == null) {
+            respond(exchange, 400, "{\"error\":\"invalid_grant\"}".getBytes(StandardCharsets.UTF_8));
+            return;
+        }
+        if (!CLIENT_SECRET.equals(form.get("client_secret"))) {
+            respond(exchange, 401, "{\"error\":\"invalid_client\"}".getBytes(StandardCharsets.UTF_8));
+            return;
+        }
+        if (!s256(form.get("code_verifier")).equals(grant.challenge())) {
+            respond(exchange, 400, "{\"error\":\"invalid_grant\",\"error_description\":\"PKCE verification failed\"}"
+                    .getBytes(StandardCharsets.UTF_8));
+            return;
+        }
+        JWTClaimsSet claims = new JWTClaimsSet.Builder()
+                .issuer(baseUrl)
+                .audience(CLIENT_ID)
+                .subject(UUID.nameUUIDFromBytes(USER_EMAIL.getBytes(StandardCharsets.UTF_8)).toString())
+                .claim("email", USER_EMAIL)
+                .claim("email_verified", true)
+                .claim("nonce", grant.nonce())
+                .expirationTime(new Date(System.currentTimeMillis() + 300_000))
+                .build();
+        SignedJWT idToken = new SignedJWT(new JWSHeader.Builder(JWSAlgorithm.RS256).keyID(KID).build(), claims);
+        try {
+            idToken.sign(new RSASSASigner(signingKey.toRSAPrivateKey()));
+        } catch (com.nimbusds.jose.JOSEException e) {
+            throw new IllegalStateException("Failed to sign the fake ID token", e);
+        }
+        Map<String, Object> response = Map.of(
+                "access_token", "access-" + UUID.randomUUID(),
+                "token_type", "Bearer",
+                "expires_in", 300,
+                "id_token", idToken.serialize());
+        respond(exchange, 200, JSON.writeValueAsBytes(response));
+    }
+
+    private static String s256(String verifier) {
+        if (verifier == null) {
+            return "";
+        }
+        try {
+            byte[] digest = MessageDigest.getInstance("SHA-256").digest(verifier.getBytes(StandardCharsets.US_ASCII));
+            return Base64.getUrlEncoder().withoutPadding().encodeToString(digest);
+        } catch (java.security.NoSuchAlgorithmException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static java.security.KeyPair generatePair() {
+        try {
+            var generator = java.security.KeyPairGenerator.getInstance("RSA");
+            generator.initialize(2048);
+            return generator.generateKeyPair();
+        } catch (Exception e) {
+            throw new IllegalStateException(e);
+        }
+    }
+
+    private static Map<String, String> query(String urlOrForm) {
+        String raw = urlOrForm.contains("?") ? urlOrForm.substring(urlOrForm.indexOf('?') + 1) : urlOrForm;
+        Map<String, String> params = new HashMap<>();
+        for (String pair : raw.split("&")) {
+            int eq = pair.indexOf('=');
+            if (eq > 0) {
+                params.put(decode(pair.substring(0, eq)), decode(pair.substring(eq + 1)));
+            }
+        }
+        return params;
+    }
+
+    private static String decode(String value) {
+        return URLDecoder.decode(value, StandardCharsets.UTF_8);
+    }
+
+    private static void respond(HttpExchange exchange, int status, byte[] body) throws IOException {
+        exchange.getResponseHeaders().add("Content-Type", "application/json");
+        exchange.sendResponseHeaders(status, body.length);
+        try (OutputStream out = exchange.getResponseBody()) {
+            out.write(body);
+        }
+    }
+}
