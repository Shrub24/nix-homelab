# secrets/.templates/services/gatus.yaml.j2 – Cloudflare Access machine credential
# Key path: secrets/services/gatus.yaml
#
# Bootstrap: just secrets bootstrap secrets/services/gatus.yaml
# Supply:    BOOTSTRAP_CF_ACCESS_CLIENT_ID — from `tofu output -json machine_access_token`
# Supply:    BOOTSTRAP_CF_ACCESS_CLIENT_SECRET — same output; it is readable once and cannot be re-read
#
# Absent, every probe keeps the loose status set and sends no headers. Present, the probe
# carries the token, so a Cloudflare Access login page can no longer pass as healthy.
cf_access:
  client_id: "{{ environ.BOOTSTRAP_CF_ACCESS_CLIENT_ID | default('PLACEHOLDER') }}"
  client_secret: "{{ environ.BOOTSTRAP_CF_ACCESS_CLIENT_SECRET | default('PLACEHOLDER') }}"
