# secrets/.templates/services/latitude.yaml.j2 – Latitude agent-observability stack secrets
# Encrypted to: oci-melb-1 (latitude service host)
# Key path: secrets/services/latitude.yaml
#
# Bootstrap: just secrets bootstrap secrets/services/latitude.yaml
# Supply:    BOOTSTRAP_SMTP_PASSWORD — Resend API key, used as the relay password (smtp.resend.com, username "resend").
{% set clickhouse_password = secrets.token_hex(24) %}
database:
  password: "{{ secrets.token_hex(24) }}" # URL-safe (interpolated into both connection strings)
clickhouse:
  password: "{{ clickhouse_password }}"
  password_sha256: "{{ hashlib.sha256(clickhouse_password.encode()).hexdigest() }}" # SHA-256 hex digest of the same plaintext
redis:
  queue_password: "{{ secrets.token_hex(24) }}" # BullMQ queue instance only (the cache instance takes no password)
master_encryption_key: "{{ secrets.token_hex(32) }}" # AES-256-GCM key for stored provider credentials; keep stable after first use
better_auth_secret: "{{ secrets.token_hex(32) }}" # signs sessions and magic-link tokens; keep stable after first use
github:
  client_id: "" # GitHub OAuth app for sign-in — the provider enables only when client_id AND client_secret are both non-empty; registered callback must be exactly https://latitude.shrublab.xyz/api/auth/callback/github
  client_secret: "" # secret of that same OAuth app (distinct from any GitHub App credentials)
  # GitHub App integration (repo connect + signal auto-resolve) — a different
  # app from the OAuth one above. Upstream enables it only when ALL SIX are
  # non-empty, so empty values keep it hidden. Register it with callback+setup
  # URL https://latitude.shrublab.xyz/integrations/github/setup/callback and
  # webhook https://latitude-api.shrublab.xyz/v1/webhooks/github, read-only
  # permissions Pull requests/Contents/Metadata, events Pull request + Push.
  app_id: ""
  app_slug: "" # from github.com/apps/<slug>
  app_private_key: "" # base64 of the generated .pem — NOT the PEM itself (upstream decodes and validates it)
  webhook_secret: "" # the App's webhook secret: the HMAC key for X-Hub-Signature-256
  app_client_id: "" # the App's OWN OAuth client id — not the SSO client_id above
  app_client_secret: ""
smtp:
  password: "{{ environ.BOOTSTRAP_SMTP_PASSWORD | default('PLACEHOLDER') }}" # Resend API key, used as the relay password (smtp.resend.com, username "resend")
