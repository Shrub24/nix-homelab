# secrets/.templates/applications/music.yaml.j2 – music stack secrets
# Encrypted to: oci-melb-1 (music stack host)
# Key path: secrets/applications/music.yaml
#
# Bootstrap: just secrets bootstrap secrets/applications/music.yaml
# Supply:    BOOTSTRAP_BEETS_DISCOGS_TOKEN — Discogs personal access token.
# Supply:    BOOTSTRAP_BEETS_SPOTIFY_CLIENT_ID — Spotify app client id.
# Supply:    BOOTSTRAP_BEETS_SPOTIFY_CLIENT_SECRET — Spotify app client secret.
# Supply:    BOOTSTRAP_BEETS_BEATPORT_USERNAME — Beatport account username.
# Supply:    BOOTSTRAP_BEETS_BEATPORT_PASSWORD — Beatport account password.
# Supply:    BOOTSTRAP_SLSKD_SLSKD_API_KEY — slskd API key.
# Supply:    BOOTSTRAP_SLSKD_SLSK_USERNAME — Soulseek account username.
# Supply:    BOOTSTRAP_SLSKD_SLSK_PASSWORD — Soulseek account password.
# Supply:    BOOTSTRAP_SLSKD_WEB_PASSWORD — slskd web UI password.
# Supply:    BOOTSTRAP_TAGR_AUTH_USER — tagr auth username (an identity choice, never invented).
# Supply:    BOOTSTRAP_TAGR_AUTH_PASSWORD — tagr auth password.
beets:
  discogs_token: "{{ environ.BOOTSTRAP_BEETS_DISCOGS_TOKEN | default('PLACEHOLDER') }}"
  spotify_client_id: "{{ environ.BOOTSTRAP_BEETS_SPOTIFY_CLIENT_ID | default('PLACEHOLDER') }}"
  spotify_client_secret: "{{ environ.BOOTSTRAP_BEETS_SPOTIFY_CLIENT_SECRET | default('PLACEHOLDER') }}"
  beatport_username: "{{ environ.BOOTSTRAP_BEETS_BEATPORT_USERNAME | default('PLACEHOLDER') }}"
  beatport_password: "{{ environ.BOOTSTRAP_BEETS_BEATPORT_PASSWORD | default('PLACEHOLDER') }}"
slskd:
  slskd_api_key: "{{ environ.BOOTSTRAP_SLSKD_SLSKD_API_KEY | default('PLACEHOLDER') }}"
  slsk_username: "{{ environ.BOOTSTRAP_SLSKD_SLSK_USERNAME | default('PLACEHOLDER') }}"
  slsk_password: "{{ environ.BOOTSTRAP_SLSKD_SLSK_PASSWORD | default('PLACEHOLDER') }}"
  web_password: "{{ environ.BOOTSTRAP_SLSKD_WEB_PASSWORD | default('PLACEHOLDER') }}"
tagr:
  auth_secret: "{{ secrets.token_hex(32) }}"
  auth_user: "{{ environ.BOOTSTRAP_TAGR_AUTH_USER | default('PLACEHOLDER') }}"
  auth_password: "{{ environ.BOOTSTRAP_TAGR_AUTH_PASSWORD | default('PLACEHOLDER') }}"
audiomuse:
  password: "{{ secrets.token_hex(32) }}"
  api_token: "{{ secrets.token_hex(32) }}"
  jwt_secret: "{{ secrets.token_hex(32) }}"
  postgres_password: "{{ secrets.token_hex(24) }}"
