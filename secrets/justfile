set shell := ["bash", "-euo", "pipefail", "-c"]
set no-cd

# Re-encrypt every SOPS-managed file (yaml/yml/json) except .templates/.
updatekeys-all:
  @while read -r f; do \
    echo "Updating $f..."; \
    sops updatekeys -y "$f"; \
  done < <(scripts/list-sops-files.sh)

# Re-encrypt only changed SOPS-managed files. Selection is the intersection of
# git-changed files under secrets/ and the canonical sops file list
# (scripts/list-sops-files.sh), so encrypted JSON is covered and templates are
# never targets.
updatekeys:
  @CANDIDATES="$( (git diff --name-only --diff-filter=ACMR HEAD -- secrets; \
      git ls-files --others --exclude-standard -- secrets) \
      | grep '^secrets/' \
      | sort -u )"; \
  FILES="$(comm -12 <(printf '%s\n' "$CANDIDATES" | sort) <(scripts/list-sops-files.sh))"; \
  if [[ -z "$FILES" ]]; then \
    echo "No changed SOPS files found."; \
    exit 0; \
  fi; \
  while read -r f; do \
    [[ -n "$f" ]] || continue; \
    echo "Updating $f..."; \
    sops updatekeys -y "$f"; \
  done <<< "$FILES"
