  origin_record_content: "{{ environ.BOOTSTRAP_CLOUDFLARE_ORIGIN_RECORD_CONTENT | default('PLACEHOLDER') }}"
  admin_email: "{{ environ.BOOTSTRAP_CLOUDFLARE_ADMIN_EMAIL | default('PLACEHOLDER') }}"
