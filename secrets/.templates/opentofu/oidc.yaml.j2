# secrets/.templates/opentofu/oidc.yaml.j2 – Cloudflare Access OIDC client secret
# Key path: secrets/opentofu/oidc.yaml
#
# Bootstrap: just secrets bootstrap secrets/opentofu/oidc.yaml
# Supply:    BOOTSTRAP_CLOUDFLARE_ACCESS_CLIENT_SECRET — Cloudflare Access OIDC application client secret.
cloudflare-access:
  client_secret: "{{ environ.BOOTSTRAP_CLOUDFLARE_ACCESS_CLIENT_SECRET | default('PLACEHOLDER') }}"
