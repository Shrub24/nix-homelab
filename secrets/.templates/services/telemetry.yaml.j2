# Latitude OTLP ingest credential for the collector's fan-out (D-074/D-076).
# UI-issued and cannot be generated: the project API key from Latitude's
# project settings (or mint a fresh one — the old key was never used).
#
# Template convention (never fail closed): values the operator fills in are
# `environ.X | default('PLACEHOLDER')` so a bare bootstrap always renders and
# encrypts; only repo-issued randomness is generated in-template. Two paths:
#
# 1. Fill at bootstrap (env var present):
#      LATITUDE_OTLP_API_KEY=… \
#        just secrets bootstrap secrets/services/telemetry.yaml
#
# 2. Fill after bootstrap (bare bootstrap encrypted placeholders):
#      sops set secrets/services/telemetry.yaml '["latitude"]["api_key"]' "\"$KEY\""
#
# Langfuse's fan-out credential does NOT live here: it is the pk-lf/sk-lf pair
# Langfuse seeds at first-run init from secrets/services/langfuse.yaml
# (otel/*), so one file issues the credential and both sides read it.
# Recipients: owner + oci-melb-1 only — the only host running the exporters.
latitude:
  api_key: "{{ environ.LATITUDE_OTLP_API_KEY | default('PLACEHOLDER') }}"
