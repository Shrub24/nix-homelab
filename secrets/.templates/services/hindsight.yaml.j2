# secrets/.templates/services/hindsight.yaml.j2 – Hindsight agent-memory secrets
# Encrypted to: home-forge (hindsight service host)
# Key path: secrets/services/hindsight.yaml
#
# Bootstrap: just secrets bootstrap secrets/services/hindsight.yaml
# Supply:    none — the two api_key values are literals the router accepts; every other value is generated.
llm:
  api_key: "sk-local" # any non-empty placeholder: the host-local router authenticates no client (e.g. sk-local)
embeddings:
  api_key: "sk-local" # gateway credential for the embedding alias (placeholder is fine if the gateway authenticates no client)
mcp:
  auth_token: "{{ secrets.token_hex(32) }}" # bearer token for hindsight's MCP endpoint
roles:
  hindsight:
    password: "{{ secrets.token_hex(24) }}" # URL-safe (interpolated into the connection string)
