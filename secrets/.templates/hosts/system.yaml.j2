# secrets/.templates/hosts/system.yaml.j2 – host-scoped bootstrap/system secrets
# Encrypted to: owner + HOST
# Key path: secrets/hosts/HOST/system.yaml
#
# This is the canonical host system template for every network-managed host,
# including home-forge (hosts/home-forge). It supplies the host-scoped secrets
# those baseline services consume:
#   - tailscale/auth_key              -> services.tailscale.authKeyFile
#   - recovery/rescue_password_hash   -> services.hostRecovery.rescueUser
#   - backup/*                        -> services.state-backups (R2 creds + restic
#                                        repository password; host-scoped only)
# The Beszel agent needs nothing from this file: its KEY is the hub's public
# key, bound as policy in policy/globals.nix. The agent enables with its
# aspect — no secret, no enrollment gate, no host-scoped credential.
# Do not add application/service workload secrets here; those use their own
# path-scoped templates under secrets/applications|services/.
#
# Bootstrap: just secrets bootstrap secrets/hosts/HOST/system.yaml
#            One run per host: every BOOTSTRAP_* value below is per-host.
# Supply:    BOOTSTRAP_TAILSCALE_AUTH_KEY — tagged Tailscale auth key for this host; per-host.
# Supply:    BOOTSTRAP_RECOVERY_RESCUE_PASSWORD_HASH — SHA-512 crypt hash of the break-glass password, not a plaintext password (mkpasswd -m sha-512); per-host.
# Supply:    BOOTSTRAP_BACKUP_S3_ACCESS_KEY_ID — R2 access key id for services.state-backups; per-host.
# Supply:    BOOTSTRAP_BACKUP_S3_SECRET_ACCESS_KEY — R2 secret access key for services.state-backups; per-host.
# Supply:    BOOTSTRAP_NIKS3_API_TOKEN — host-scoped niks3 API token for pushing closures to the sovereign Nix binary cache; per-host.
# Supply:    BOOTSTRAP_COCKPIT_SERVICE_USER_PASSWORD_HASH — SHA-512 crypt hash for the restricted Cockpit service account (services.admin.cockpit.serviceUser), not a plaintext password (mkpasswd -m sha-512); per-host.
# Supply:    BOOTSTRAP_NTFY_TOKEN — ntfy publish token for services.notification-daemon, sent as Authorization: Bearer; per-host, must equal the auth-tokens entry in secrets/services/ntfy.yaml.
# Supply:    BOOTSTRAP_IDENTITY_SSH_PRIVATE_KEY — this host's SSH private key, BEGIN and END lines included; per-host.
tailscale:
  auth_key: "{{ environ.BOOTSTRAP_TAILSCALE_AUTH_KEY | default('PLACEHOLDER') }}"
recovery:
  # Console-only break-glass password hash for services.hostRecovery.
  rescue_password_hash: "{{ environ.BOOTSTRAP_RECOVERY_RESCUE_PASSWORD_HASH | default('PLACEHOLDER') }}"
backup:
  # Host-scoped backup credentials for services.state-backups.
  # These map to defaults in modules/services/state-backups.nix:
  # - backup/s3_access_key_id
  # - backup/s3_secret_access_key
  # - backup/restic_password
  s3_access_key_id: "{{ environ.BOOTSTRAP_BACKUP_S3_ACCESS_KEY_ID | default('PLACEHOLDER') }}"
  s3_secret_access_key: "{{ environ.BOOTSTRAP_BACKUP_S3_SECRET_ACCESS_KEY | default('PLACEHOLDER') }}"
  restic_password: "{{ secrets.token_hex(32) }}" # keep stable after first use
niks3:
  # Host-scoped niks3 secrets for the sovereign Nix binary cache.
  # api_token: host-scoped API token for pushing closures to niks3.
  api_token: "{{ environ.BOOTSTRAP_NIKS3_API_TOKEN | default('PLACEHOLDER') }}"
cockpit:
  service_user:
    # Password hash for the restricted Cockpit service account
    # (services.admin.cockpit.serviceUser).
    password_hash: "{{ environ.BOOTSTRAP_COCKPIT_SERVICE_USER_PASSWORD_HASH | default('PLACEHOLDER') }}"
# Host-scoped ntfy token for services.notification-daemon.
# Sent as Authorization: Bearer header to the ntfy server.
ntfy_token: "{{ environ.BOOTSTRAP_NTFY_TOKEN | default('PLACEHOLDER') }}"
identity:
  # Expected shape; the exported value carries the PEM wrapper lines itself:
  #   -----BEGIN OPENSSH PRIVATE KEY-----
  #   -----END OPENSSH PRIVATE KEY-----
  ssh_private_key: |
    {{ environ.BOOTSTRAP_IDENTITY_SSH_PRIVATE_KEY | default('PLACEHOLDER') | indent(4) }}
