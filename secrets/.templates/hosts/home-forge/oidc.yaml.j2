# secrets/.templates/hosts/home-forge/oidc.yaml.j2 – home-forge OIDC client secrets
# Encrypted to: owner + home-forge + la-admin-1 (the identity provider)
# Key path: secrets/hosts/home-forge/oidc.yaml
# Only client_secret is needed; client_id is the canonical Kanidm oauth2 client name.
#
# This file is the authority for the secrets of the clients that run here: the
# provider pushes each client_secret into Kanidm at activation, and the consumer
# reads the same value from the same file. Every value is generated, so nothing
# is supplied. Create it once with
#   just secrets bootstrap secrets/hosts/home-forge/oidc.yaml
# and edit it with `sops` afterwards — re-bootstrapping rotates all of them.
grafana:
  client_secret: "{{ secrets.token_hex(32) }}"
  # Grafana's own cookie/datasource encryption key rides beside its client
  # secret: the provider reads only client_secret, this host reads both.
  secret_key: "{{ secrets.token_hex(32) }}"
langfuse:
  client_secret: "{{ secrets.token_hex(32) }}"
