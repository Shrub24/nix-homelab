# secrets/.templates/services/bifrost.yaml.j2 – Bifrost gateway secrets
# Encrypted to: oci-melb-1 (gateway host)
# Key path: secrets/services/bifrost.yaml
#
# Bootstrap: just secrets bootstrap secrets/services/bifrost.yaml
# Supply:    BOOTSTRAP_BIFROST_ADMIN_USERNAME — dashboard / management API username (an identity choice, never invented).
# Supply:    BOOTSTRAP_BIFROST_GEMINI_API_KEY — Google Gemini API key.
# Supply:    BOOTSTRAP_BIFROST_DEEPSEEK_API_KEY — DeepSeek API key.
# Supply:    BOOTSTRAP_BIFROST_OPENCODE_API_KEY — opencode API key (pooled, key 1 of 2).
# Supply:    BOOTSTRAP_BIFROST_OPENCODE_API_KEY_2 — opencode API key (pooled, key 2 of 2).
# Supply:    BOOTSTRAP_BIFROST_OPENROUTER_API_KEY — OpenRouter API key.
# Supply:    BOOTSTRAP_BIFROST_VOYAGE_API_KEY — Voyage AI API key; serves the embedding alias (voyage/voyage-4).
bifrost:
  encryption_key: "{{ secrets.token_hex(32) }}"
  admin_username: "{{ environ.BOOTSTRAP_BIFROST_ADMIN_USERNAME | default('PLACEHOLDER') }}"
  admin_password: "{{ base64.b64encode(secrets.token_bytes(18)).decode() }}" # generated at bootstrap, the shape `openssl rand -base64 24` used to prescribe
  gemini_api_key: "{{ environ.BOOTSTRAP_BIFROST_GEMINI_API_KEY | default('PLACEHOLDER') }}"
  deepseek_api_key: "{{ environ.BOOTSTRAP_BIFROST_DEEPSEEK_API_KEY | default('PLACEHOLDER') }}"
  opencode_api_key: "{{ environ.BOOTSTRAP_BIFROST_OPENCODE_API_KEY | default('PLACEHOLDER') }}" # opencode-go key pool: Bifrost rotates on 429, so the two keys are interchangeable capacity
  opencode_api_key_2: "{{ environ.BOOTSTRAP_BIFROST_OPENCODE_API_KEY_2 | default('PLACEHOLDER') }}"
  openrouter_api_key: "{{ environ.BOOTSTRAP_BIFROST_OPENROUTER_API_KEY | default('PLACEHOLDER') }}"
  voyage_api_key: "{{ environ.BOOTSTRAP_BIFROST_VOYAGE_API_KEY | default('PLACEHOLDER') }}" # Voyage AI; serves the embedding alias (voyage/voyage-4)
