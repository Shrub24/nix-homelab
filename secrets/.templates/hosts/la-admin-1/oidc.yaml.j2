# secrets/.templates/hosts/la-admin-1/oidc.yaml.j2 – la-admin-1 OIDC client secrets
# Encrypted to: owner + la-admin-1 (this host is also the identity provider)
# Key path: secrets/hosts/la-admin-1/oidc.yaml
# Only client_secret is needed; client_id is the canonical OIDC client name.
#
# This file is the authority for the secrets of the clients that run here: the
# provider pushes each client_secret into the provider at activation, and the consumer
# reads the same value from the same file. Every value is generated, so nothing
# is supplied. Create it once with
#   just secrets bootstrap secrets/hosts/la-admin-1/oidc.yaml
# and edit it with `sops` afterwards — re-bootstrapping rotates all of them.
beszel:
  client_secret: "{{ secrets.token_hex(32) }}"
termix:
  client_secret: "{{ secrets.token_hex(32) }}"
