# secrets/.templates/services/niks3.yaml.j2 – sovereign Nix binary cache secrets
# Key path: secrets/services/niks3.yaml
#
# Bootstrap: just secrets bootstrap secrets/services/niks3.yaml
# Supply:    BOOTSTRAP_NIKS3_SIGNING_KEY — base64 ed25519 private key, operator-generated (ssh-keygen -t ed25519 -N '' then base64); it must stay stable, every closure signed with it depends on it.
# Supply:    BOOTSTRAP_NIKS3_S3_ACCESS_KEY_ID — S3 access key id for the cache bucket.
# Supply:    BOOTSTRAP_NIKS3_S3_SECRET_ACCESS_KEY — S3 secret access key for the cache bucket.
signing_key: "{{ environ.BOOTSTRAP_NIKS3_SIGNING_KEY | default('PLACEHOLDER') }}"
s3_access_key_id: "{{ environ.BOOTSTRAP_NIKS3_S3_ACCESS_KEY_ID | default('PLACEHOLDER') }}"
s3_secret_access_key: "{{ environ.BOOTSTRAP_NIKS3_S3_SECRET_ACCESS_KEY | default('PLACEHOLDER') }}"
