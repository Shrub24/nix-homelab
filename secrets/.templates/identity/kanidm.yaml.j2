# secrets/.templates/identity/kanidm.yaml.j2 – Kanidm bootstrap admin passwords
# Key path: secrets/identity/kanidm.yaml
#
# Bootstrap: just secrets bootstrap secrets/identity/kanidm.yaml
#
# Set at provider provisioning (a fresh Kanidm instance holds no password yet);
# rotate both after first login.
kanidm:
  admin_password: "{{ secrets.token_hex(24) }}" # set at provider provisioning; rotate after first login
  idm_admin_password: "{{ secrets.token_hex(24) }}" # set at provider provisioning; rotate after first login
