{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "automerge": false,
  "schedule": ["before 6am on monday"],
  "enabledManagers": ["custom.regex", "github-actions"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update OCI image refs (tag + digest) in policy/oci-images.nix",
      "managerFilePatterns": ["/policy/oci-images\\.nix$/"],
      "matchStrings": [
        "\"(?<depName>[^\"]+):(?<currentValue>[^\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "degoog release tag (tags only: upstream publishes no GitHub releases)",
      "managerFilePatterns": ["/modules/knowledge/degoog\\.nix$/"],
      "matchStrings": ["degoog-org/degoog/(?<currentValue>[0-9][^\"\\s]*)\""],
      "depNameTemplate": "degoog-org/degoog",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "bun2nix release tag: the generator behind pkgs/degoog/bun.nix",
      "managerFilePatterns": ["/modules/flake/inputs\\.nix$/"],
      "matchStrings": ["bun2nix\\.url = \"github:nix-community/bun2nix/(?<currentValue>[0-9][^\"\\s]*)\""],
      "depNameTemplate": "nix-community/bun2nix",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["policy/oci-images.nix"],
      "groupName": "OCI image refs",
      "commitMessageTopic": "OCI image refs"
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["modules/knowledge/degoog.nix", "modules/flake/inputs.nix"],
      "groupName": "degoog and bun2nix releases",
      "commitMessageTopic": "degoog/bun2nix"
    }
  ]
}
