@@ -0,0 +1,155 @@
+package org.github.tess1o.geopulse.auth.oidc.service;
+
+import io.quarkus.narayana.jta.QuarkusTransaction;
+import io.quarkus.test.common.QuarkusTestResource;
+import io.quarkus.test.junit.QuarkusTest;
+import jakarta.inject.Inject;
+import org.github.tess1o.geopulse.auth.oidc.dto.OidcCallbackAuthResult;
+import org.github.tess1o.geopulse.auth.oidc.dto.OidcCallbackRequest;
+import org.github.tess1o.geopulse.auth.oidc.dto.OidcLoginInitResponse;
+import org.github.tess1o.geopulse.auth.oidc.model.OidcSessionStateEntity;
+import org.github.tess1o.geopulse.auth.oidc.repository.OidcSessionStateRepository;
+import org.github.tess1o.geopulse.db.PostgisTestResource;
+import org.github.tess1o.geopulse.testsupport.SerializedDatabaseTest;
+import org.junit.jupiter.api.Test;
+
+import java.net.URLDecoder;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.time.Instant;
+import java.time.temporal.ChronoUnit;
+import java.util.Base64;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+/**
+ * PKCE (RFC 7636) on the GeoPulse login flow, exercised end to end against the in-process provider.
+ */
+@QuarkusTest
+@QuarkusTestResource(value = PostgisTestResource.class)
+@QuarkusTestResource(value = FakeOidcProviderResource.class)
+@SerializedDatabaseTest
+public class OidcPkceTest {
+
+    @Inject
+    OidcAuthenticationService oidcAuthenticationService;
+
+    @Inject
+    OidcSessionStateRepository sessionStateRepository;
+
+    @Test
+    void authorizationUrlCarriesS256ChallengeOfTheStoredVerifier() throws Exception {
+        OidcLoginInitResponse login = initiateLogin();
+
+        String challenge = query(login.getAuthorizationUrl()).get("code_challenge");
+        assertNotNull(challenge);
+        assertEquals("S256", FakeOidcProviderResource.challengeMethod(login.getAuthorizationUrl()));
+        assertEquals(challenge, s256(storedVerifier(login.getState())),
+                "challenge must be the S256 of the verifier persisted with this login state");
+    }
+
+    @Test
+    void matchingVerifierCompletesLoginAndConsumesState() {
+        OidcLoginInitResponse login = initiateLogin();
+
+        OidcCallbackAuthResult result = callback(login);
+
+        assertNotNull(result.user(), "a matching verifier must resolve the user");
+        assertNotNull(result.idToken());
+        assertTrue(sessionStateRepository.findByStateToken(login.getState()).isEmpty());
+    }
+
+    @Test
+    void replayedStateIsRejected() {
+        OidcLoginInitResponse login = initiateLogin();
+        callback(login);
+
+        assertRejected(login.getState(), "Invalid state token");
+    }
+
+    @Test
+    void unknownStateIsRejected() {
+        OidcLoginInitResponse login = initiateLogin();
+
+        assertRejected("never-issued-state", "Invalid state token");
+        // the unrelated login state is untouched by a rejected unknown state
+        assertTrue(sessionStateRepository.findByStateToken(login.getState()).isPresent());
+    }
+
+    @Test
+    void expiredStateIsRejectedAndConsumed() {
+        OidcLoginInitResponse login = initiateLogin();
+        QuarkusTransaction.requiringNew().run(() -> {
+            OidcSessionStateEntity state = sessionStateRepository.findByStateToken(login.getState()).orElseThrow();
+            state.setExpiresAt(Instant.now().minus(1, ChronoUnit.MINUTES));
+        });
+
+        assertRejected(login.getState(), "State token expired");
+        assertTrue(sessionStateRepository.findByStateToken(login.getState()).isEmpty());
+    }
+
+    @Test
+    void wrongVerifierIsRejectedAndStateStaysConsumed() {
+        OidcLoginInitResponse login = initiateLogin();
+        QuarkusTransaction.requiringNew().run(() -> {
+            OidcSessionStateEntity state = sessionStateRepository.findByStateToken(login.getState()).orElseThrow();
+            state.setCodeVerifier("wrong-" + UUID.randomUUID() + UUID.randomUUID());
+        });
+        String code = FakeOidcProviderResource.authorize(login.getAuthorizationUrl());
+
+        assertRejected(login.getState(), code, "Failed to exchange authorization code");
+        // a failed exchange must not roll back the consumption, so the same state cannot be retried
+        assertRejected(login.getState(), code, "Invalid state token");
+    }
+
+    private OidcLoginInitResponse initiateLogin() {
+        return oidcAuthenticationService.initiateLogin(FakeOidcProviderResource.PROVIDER, null,
+                "http://localhost/oidc/callback", null);
+    }
+
+    private OidcCallbackAuthResult callback(OidcLoginInitResponse login) {
+        String code = FakeOidcProviderResource.authorize(login.getAuthorizationUrl());
+        return oidcAuthenticationService.handleCallback(new OidcCallbackRequest(code, login.getState()));
+    }
+
+    private void assertRejected(String state, String expectedMessage) {
+        assertRejected(state, "unused-code", expectedMessage);
+    }
+
+    private void assertRejected(String state, String code, String expectedMessage) {
+        RuntimeException failure = assertThrows(RuntimeException.class,
+                () -> oidcAuthenticationService.handleCallback(new OidcCallbackRequest(code, state)));
+        assertTrue(causeChainContains(failure, expectedMessage),
+                "expected rejection containing '" + expectedMessage + "' but was: " + failure);
+    }
+
+    private static boolean causeChainContains(Throwable failure, String text) {
+        for (Throwable t = failure; t != null; t = t.getCause()) {
+            if (t.getMessage() != null && t.getMessage().contains(text)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private String storedVerifier(String state) {
+        return sessionStateRepository.findByStateToken(state).orElseThrow().getCodeVerifier();
+    }
+
+    private static String s256(String verifier) throws Exception {
+        byte[] digest = MessageDigest.getInstance("SHA-256").digest(verifier.getBytes(StandardCharsets.US_ASCII));
+        return Base64.getUrlEncoder().withoutPadding().encodeToString(digest);
+    }
+
+    private static Map<String, String> query(String url) {
+        Map<String, String> params = new HashMap<>();
+        for (String pair : url.substring(url.indexOf('?') + 1).split("&")) {
+            int eq = pair.indexOf('=');
+            params.put(pair.substring(0, eq), URLDecoder.decode(pair.substring(eq + 1), StandardCharsets.UTF_8));
+        }
+        return params;
+    }
+}
