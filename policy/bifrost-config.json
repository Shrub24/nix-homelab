{
  "$schema": "https://www.getbifrost.ai/schema",
  "version": 2,
  "source_of_truth": "config.json",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "auth_config": {
    "is_enabled": true,
    "admin_username": "env.BIFROST_ADMIN_USERNAME",
    "admin_password": "env.BIFROST_ADMIN_PASSWORD"
  },
  "client": {
    "enable_logging": true,
    "disable_content_logging": true,
    "log_retention_days": 7
  },
  "providers": {
    "gemini": {
      "keys": [
        {
          "name": "gemini-primary",
          "value": "env.GEMINI_API_KEY",
          "weight": 1,
          "models": [
            "*"
          ]
        }
      ]
    },
    "voyage": {
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": false,
          "embedding": true
        },
        "request_path_overrides": {
          "embedding": "https://api.voyageai.com/v1/embeddings"
        }
      },
      "network_config": {
        "base_url": "https://api.voyageai.com/v1"
      },
      "keys": [
        {
          "name": "voyage-primary",
          "value": "env.VOYAGE_API_KEY",
          "weight": 1,
          "models": [
            "voyage-4"
          ]
        }
      ]
    },
    "deepseek": {
      "network_config": {
        "base_url": "https://api.deepseek.com"
      },
      "keys": [
        {
          "name": "deepseek-primary",
          "value": "env.DEEPSEEK_API_KEY",
          "weight": 1,
          "models": [
            "*"
          ]
        }
      ]
    },
    "opencode-go": {
      "network_config": {
        "base_url": "https://opencode.ai/zen/go",
        "extra_headers": {
          "x-opencode-session": "shrublab-fleet"
        },
        "max_retries": 3
      },
      "keys": [
        {
          "name": "opencode-go-primary",
          "value": "env.OPENCODE_API_KEY",
          "weight": 1,
          "models": [
            "*"
          ]
        },
        {
          "name": "opencode-go-secondary",
          "value": "env.OPENCODE_API_KEY_2",
          "weight": 1,
          "models": [
            "*"
          ]
        }
      ]
    },
    "neuralwatt": {
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "network_config": {
        "base_url": "https://api.neuralwatt.com/v1"
      },
      "keys": [
        {
          "name": "neuralwatt-primary",
          "value": "env.NEURALWATT_API_KEY",
          "weight": 1,
          "models": [
            "deepseek-v4.1-flash",
            "deepseek-v4.1-flash-flex"
          ]
        }
      ]
    },
    "merge-gateway": {
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "network_config": {
        "base_url": "https://api-gateway.merge.dev/v1/openai"
      },
      "keys": [
        {
          "name": "merge-gateway-primary",
          "value": "env.MERGE_GATEWAY_API_KEY",
          "weight": 1,
          "models": [
            "deepseek/deepseek-v4.1-flash-1017"
          ]
        }
      ]
    },
    "command-code": {
      "custom_provider_config": {
        "base_provider_type": "openai"
      },
      "network_config": {
        "base_url": "https://api.commandcode.ai/provider"
      },
      "keys": [
        {
          "name": "command-code-primary",
          "value": "env.COMMAND_CODE_API_KEY",
          "weight": 1,
          "models": [
            "*"
          ]
        }
      ]
    },
    "command-code-decisions": {
      "custom_provider_config": {
        "base_provider_type": "typesafe",
        "allowed_requests": {
          "decisions": true
        }
      },
      "network_config": {
        "base_url": "https://api.commandcode.ai/provider"
      },
      "keys": [
        {
          "name": "command-code-decisions-primary",
          "value": "env.COMMAND_CODE_API_KEY",
          "weight": 1,
          "models": [
            "typesafe/jev-1.14.0"
          ]
        }
      ]
    },
    "openrouter": {
      "keys": [
        {
          "name": "openrouter-primary",
          "value": "env.OPENROUTER_API_KEY",
          "weight": 1,
          "models": [
            "*"
          ]
        }
      ]
    }
  },
  "governance": {
    "routing_rules": [
      {
        "id": "text-fast",
        "name": "text-fast",
        "enabled": true,
        "priority": 6,
        "scope": "global",
        "cel_expression": "model == 'text-fast'",
        "targets": [
          {
            "provider": "neuralwatt",
            "model": "deepseek-v4.1-flash",
            "weight": 1.0
          }
        ]
      },
      {
        "id": "text-flex",
        "name": "text-flex",
        "enabled": true,
        "priority": 7,
        "scope": "global",
        "cel_expression": "model == 'text-flex'",
        "targets": [
          {
            "provider": "neuralwatt",
            "model": "deepseek-v4.1-flash-flex",
            "weight": 1.0
          }
        ]
      },
      {
        "id": "inbox-zero-text",
        "name": "inbox-zero-text",
        "enabled": true,
        "priority": 50,
        "scope": "global",
        "cel_expression": "model == 'inbox-zero-text'",
        "targets": [
          {
            "provider": "merge-gateway",
            "model": "deepseek/deepseek-v4.1-flash-1017",
            "weight": 1.0
          }
        ]
      },
      {
        "id": "embedding",
        "name": "embedding",
        "enabled": true,
        "priority": 30,
        "scope": "global",
        "cel_expression": "model == 'shrublab-embedding'",
        "targets": [
          {
            "provider": "voyage",
            "model": "voyage-4",
            "weight": 1.0
          }
        ]
      },
      {
        "id": "summariser",
        "name": "summariser",
        "enabled": true,
        "priority": 10,
        "scope": "global",
        "cel_expression": "model == 'shrublab-text'",
        "fallbacks": [
          "opencode-go/mimo-v2.6-flash",
          "deepseek/deepseek-chat",
          "gemini/gemini-flash-latest"
        ],
        "targets": [
          {
            "provider": "opencode-go",
            "model": "deepseek-v4.1-flash",
            "weight": 1.0
          }
        ]
      },
      {
        "id": "image",
        "name": "image",
        "enabled": true,
        "priority": 20,
        "scope": "global",
        "cel_expression": "model == 'shrublab-image'",
        "fallbacks": [
          "opencode-go/deepseek-v4.1-flash",
          "gemini/gemini-flash-latest"
        ],
        "targets": [
          {
            "provider": "opencode-go",
            "model": "mimo-v2.6-flash",
            "weight": 1.0
          }
        ]
      },
      {
        "id": "budget",
        "name": "budget",
        "enabled": true,
        "priority": 40,
        "scope": "global",
        "cel_expression": "model == 'shrublab-fallback'",
        "fallbacks": [
          "opencode-go/mimo-v2.6-flash",
          "deepseek/deepseek-chat",
          "gemini/gemini-flash-latest"
        ],
        "targets": [
          {
            "provider": "opencode-go",
            "model": "deepseek-v4.1-flash",
            "weight": 1.0
          }
        ]
      }
    ]
  }
}
