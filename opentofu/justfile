set shell := ["bash", "-euo", "pipefail", "-c"]
set no-cd

# Refresh and validate the committed service policy export.
sync host="":
    @./scripts/export-web-services-policy.sh {{ host }}
    @./tests/check-web-services-policy.sh {{ host }}

_runtime:
    @PYTHONHASHSEED=0 ./scripts/render-opentofu-cloudflare-runtime.sh

# Initialize services, or select shared infrastructure with --foundation.
[positional-arguments]
init *args:
    @./scripts/cloudflare-tofu.sh init "$@"

# Apply services; --foundation selects infrastructure, --sync refreshes policy first.
[positional-arguments]
apply *args:
    @./scripts/cloudflare-tofu.sh apply "$@"
