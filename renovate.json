{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "automerge": false,
  "schedule": [
    "before 6am on monday"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "enabledManagers": [
    "nix",
    "github-actions",
    "custom.regex"
  ],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update OCI image refs (tag + digest) in policy/oci-images.nix",
      "managerFilePatterns": [
        "/policy/oci-images\\.nix$/"
      ],
      "matchStrings": [
        "\"(?<depName>[^\"]+):(?<currentValue>[^\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "nix"
      ],
      "groupName": "nix flake inputs"
    },
    {
      "description": "Frozen at the revision whose clickhouse links; the shared baseline's does not (D-080)",
      "matchManagers": [
        "nix"
      ],
      "matchDepNames": [
        "nixpkgs-clickhouse"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "OCI image refs",
      "commitMessageTopic": "OCI image refs"
    }
  ]
}
