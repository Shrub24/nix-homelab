# secrets/.templates/services/bookorbit.yaml.j2 – BookOrbit library secrets
# Encrypted to: home-forge (BookOrbit host)
# Key path: secrets/services/bookorbit.yaml
#
# Bootstrap: just secrets bootstrap secrets/services/bookorbit.yaml
# Supply:    none — every value is generated. The OIDC client secret lives in secrets/hosts/home-forge/oidc.yaml.
roles:
  bookorbit:
    password: "{{ secrets.token_hex(24) }}" # URL-safe (interpolated into DATABASE_URL)
app:
  jwt_secret: "{{ secrets.token_hex(32) }}"
  podcast_encryption_key: "{{ secrets.token_hex(32) }}"
  setup_bootstrap_token: "{{ secrets.token_hex(32) }}"
  book_request_encryption_key: "{{ secrets.token_hex(32) }}"
  email_encryption_key: "{{ secrets.token_hex(32) }}"
