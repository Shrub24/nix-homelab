# secrets/.templates/identity/authentik.yaml.j2 – Authentik runtime secrets (oci-melb-1)
# Key path: secrets/identity/authentik.yaml
#
# Bootstrap: just secrets bootstrap secrets/identity/authentik.yaml
#
# The provider stays inert until this file exists. Generated values are filled in by
# bootstrap; the SMTP pair is the relay account Authentik sends through.
# Runbook: docs/runbooks/authentik-secrets.md
authentik:
  secret_key: "{{ secrets.token_hex(32) }}" # signs sessions; losing it invalidates them
  postgres_password: "{{ secrets.token_hex(24) }}" # the same value provisions the role
  bootstrap_password: "{{ secrets.token_hex(24) }}" # first administrator; rotate after first login
  bootstrap_token: "{{ secrets.token_hex(32) }}" # API token for the same administrator
  smtp_username: "{{ environ.BOOTSTRAP_AUTHENTIK_SMTP_USERNAME | default('PLACEHOLDER') }}"
  smtp_password: "{{ environ.BOOTSTRAP_AUTHENTIK_SMTP_PASSWORD | default('PLACEHOLDER') }}"
