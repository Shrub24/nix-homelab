# secrets/.templates/services/sparkyfitness.yaml.j2 — SparkyFitness secrets (service scope)
# Encrypted to: oci-melb-1 (the SparkyFitness host, which also runs the identity provider)
# and the owner
# Key path: secrets/services/sparkyfitness.yaml
#
# Bootstrap:
#   just secrets bootstrap secrets/services/sparkyfitness.yaml
#   sops updatekeys secrets/services/sparkyfitness.yaml
#
# Generated: the two database passwords and the two application secrets, read by the consumer
# registration in modules/apps/sparkyfitness.nix and by the rendered environment file.
#   roles/sparkyfitness/password      migration owner; the substrate provisions it
#   roles/sparkyfitness-app/password  restricted login the server runs as
#   app/encryption_key                64 hex characters (upstream rejects any other length);
#                                     it decrypts stored integration credentials, so a restore
#                                     without it loses them
#   app/better_auth_secret            session signing key
#
# The OIDC client secret is not here: it lives with the host's other client secrets in
# secrets/hosts/oci-melb-1/oidc.yaml, which the identity provider also reads.
roles:
  sparkyfitness:
    password: "{{ secrets.token_hex(24) }}"
  sparkyfitness-app:
    password: "{{ secrets.token_hex(24) }}"
app:
  encryption_key: "{{ secrets.token_hex(32) }}"
  better_auth_secret: "{{ secrets.token_urlsafe(32) }}"
