{
  "systems": {
    "oauth2": {
      "beszel": {
        "enable": true,
        "displayName": "Beszel",
        "secretKeyPrefix": "beszel",
        "routeKey": "beszel-admin",
        "callbackPath": "/api/oauth2-redirect",
        "scopeMaps": {
          "admins": ["openid", "profile", "email"]
        }
      },
      "termix": {
        "enable": true,
        "displayName": "Termix",
        "secretKeyPrefix": "termix",
        "routeKey": "termix-admin",
        "callbackPath": "/users/oidc/callback",
        "allowInsecureClientDisablePkce": true,
        "scopeMaps": {
          "admins": ["openid", "profile", "email"]
        }
      },
      "karakeep": {
        "enable": true,
        "displayName": "Karakeep",
        "secretKeyPrefix": "karakeep",
        "routeKey": "karakeep",
        "callbackPath": "/api/auth/callback/custom",
        "enableLegacyCrypto": true,
        "scopeMaps": {
          "service-admins": ["openid", "profile", "email"],
          "users": ["openid", "profile", "email"]
        }
      },
      "paperless": {
        "enable": true,
        "displayName": "Paperless",
        "secretKeyPrefix": "paperless",
        "routeKey": "paperless",
        "callbackPath": "/accounts/oidc/kanidm/login/callback/",
        "scopeMaps": {
          "service-admins": ["openid", "profile", "email", "groups_name"],
          "users": ["openid", "profile", "email", "groups_name"]
        }
      },
      "langfuse": {
        "enable": true,
        "displayName": "Langfuse",
        "secretKeyPrefix": "langfuse",
        "routeKey": "langfuse",
        "callbackPath": "/api/auth/callback/custom",
        "scopeMaps": {
          "service-admins": ["openid", "profile", "email"],
          "users": ["openid", "profile", "email"]
        }
      },
      "grafana": {
        "enable": true,
        "displayName": "Grafana",
        "secretKeyPrefix": "grafana",
        "routeKey": "grafana",
        "callbackPath": "/login/generic_oauth",
        "scopeMaps": {
          "admins": ["openid", "profile", "email", "groups_name"]
        }
      },
      "actual": {
        "enable": true,
        "displayName": "Actual Budget",
        "secretKeyPrefix": "actual",
        "routeKey": "actual",
        "callbackPath": "/openid/callback",
        "enableLegacyCrypto": true,
        "scopeMaps": {
          "service-admins": ["openid", "profile", "email"],
          "users": ["openid", "profile", "email"]
        }
      },
      "memos": {
        "enable": true,
        "displayName": "Memos",
        "secretKeyPrefix": "memos",
        "routeKey": "memos",
        "callbackPath": "/auth/callback",
        "scopeMaps": {
          "service-admins": ["openid", "profile", "email"],
          "users": ["openid", "profile", "email"]
        }
      },
      "tududi": {
        "enable": true,
        "displayName": "tududi",
        "secretKeyPrefix": "tududi",
        "routeKey": "tududi",
        "callbackPath": "/api/oidc/callback/kanidm",
        "enableLegacyCrypto": true,
        "scopeMaps": {
          "service-admins": ["openid", "profile", "email"],
          "users": ["openid", "profile", "email"]
        }
      },
      "geopulse": {
        "enable": true,
        "displayName": "GeoPulse",
        "secretKeyPrefix": "geopulse",
        "routeKey": "geopulse",
        "callbackPath": "/oidc/callback",
    "includePrivateEndpointCallback": true,
        "enableLegacyCrypto": true,
        "scopeMaps": {
          "users": ["openid", "profile", "email"]
        }
      },
      "homarr": {
        "enable": true,
        "displayName": "Homarr",
        "secretKeyPrefix": "homarr",
        "routeKey": "homarr",
        "callbackPath": "/api/auth/callback/oidc",
        "includePrivateEndpointCallback": true,
        "scopeMaps": {
          "service-admins": ["openid", "profile", "email", "groups_name"],
          "users": ["openid", "profile", "email", "groups_name"]
        }
      },
      "cloudflare-access": {
        "enable": true,
        "displayName": "Cloudflare Access",
        "secretKeyPrefix": "cloudflare-access",
        "originUrl": "https://shrublab.cloudflareaccess.com/cdn-cgi/access/callback",
        "scopeMaps": {
          "admins": ["openid", "profile", "email", "groups_name"],
          "users": ["openid", "profile", "email", "groups_name"]
        }
      }
    }
  }
}
