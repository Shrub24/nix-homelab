# secrets/.templates/services/karakeep-pod.yaml.j2 – karakeep standalone secrets
# Encrypted to: karakeep-pod (karakeep service host)
# Key path: secrets/services/karakeep-pod.yaml
#
# Bootstrap: just secrets bootstrap secrets/services/karakeep-pod.yaml
# Supply:    BOOTSTRAP_KARAKEEP_ASSET_STORE_S3_ACCESS_KEY_ID — R2 access key id for the karakeep asset store bucket.
# Supply:    BOOTSTRAP_KARAKEEP_ASSET_STORE_S3_SECRET_ACCESS_KEY — R2 secret access key for the karakeep asset store bucket.
karakeep:
  nextauth_secret: "{{ secrets.token_hex(32) }}"
  meilisearch_master_key: "{{ secrets.token_hex(32) }}"
  asset_store_s3_access_key_id: "{{ environ.BOOTSTRAP_KARAKEEP_ASSET_STORE_S3_ACCESS_KEY_ID | default('PLACEHOLDER') }}"
  asset_store_s3_secret_access_key: "{{ environ.BOOTSTRAP_KARAKEEP_ASSET_STORE_S3_SECRET_ACCESS_KEY | default('PLACEHOLDER') }}"
