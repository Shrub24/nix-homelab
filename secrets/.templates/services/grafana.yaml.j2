# secrets/.templates/services/grafana.yaml.j2 – Grafana break-glass administrator credential
# Encrypted to: owner + home-forge (the observability store host)
# Key path: secrets/services/grafana.yaml
#
# Grafana signs in through the identity provider, so the local login form is hidden.
# This credential is what the form falls back to: re-enable it with a deploy and sign in
# as the local administrator, which needs the host but not the provider.
#
# It is service-scoped rather than part of hosts/home-forge/oidc.yaml because that file is
# also readable by oci-melb-1, which needs the client secrets to provision providers and has
# no reason to hold a credential that bypasses them.
#
# Grafana applies admin_password only while the administrator account does not exist. On an
# instance that already has one, rotate with `grafana cli admin reset-admin-password`.
#
# Bootstrap: just secrets bootstrap secrets/services/grafana.yaml
grafana:
  admin_password: "{{ secrets.token_urlsafe(32) }}"
