# secrets/.templates/services/paperless.yaml.j2 – Paperless-ngx service environment secrets
# Encrypted to: owner, oci-melb-1
# Key path: secrets/services/paperless.yaml
# Used as sops key source for the paperless service container.
#
# Bootstrap: just secrets bootstrap secrets/services/paperless.yaml
# Supply:    BOOTSTRAP_PAPERLESS_GPT_API_TOKEN — Paperless-gpt API token from the Paperless web UI: Settings → API Tokens → Create.
paperless:
  secret_key: "{{ secrets.token_hex(32) }}"
  admin_pass: "{{ secrets.token_hex(24) }}"

# Paperless-gpt API token stored here (same file, separate key path).
paperless-gpt:
  api_token: "{{ environ.BOOTSTRAP_PAPERLESS_GPT_API_TOKEN | default('PLACEHOLDER') }}"
