# secrets/.templates/services/geopulse.yaml.j2 — GeoPulse secrets (service scope)
# Encrypted to: oci-melb-1 (the GeoPulse host) and the owner
# Key path: secrets/services/geopulse.yaml
#
# Bootstrap:
#   just secrets bootstrap secrets/services/geopulse.yaml
#   sops updatekeys secrets/services/geopulse.yaml
#
# Generated: the database password, which the consumer registration in
# modules/apps/geopulse.nix reads at roles/geopulse/password — the same value
# the PostgreSQL substrate provisions the role with.
#
# Operator-issued: the three keys upstream would generate on first start. They
# render empty and are filled with `sops edit` afterwards, so key material never
# reaches an argument list or shell history. See docs/runbooks/geopulse.md for
# generation commands, formats and recovery; an empty key must fail startup.
#   jwt/private_key    PKCS#8 PEM          openssl genpkey -algorithm RSA
#   jwt/public_key     SubjectPublicKeyInfo PEM   openssl rsa -pubout
#   ai/encryption_key  base64 of 32 bytes  openssl rand -base64 32
#
# The AI encryption key also decrypts the OIDC provider client secret held in
# the database, so a restore or a rotation that loses it makes that secret
# unreadable (design GP-6).
roles:
  geopulse:
    password: "{{ secrets.token_hex(24) }}" # URL-safe: interpolated into a connection env var
jwt:
  private_key: ""
  public_key: ""
ai:
  encryption_key: ""
