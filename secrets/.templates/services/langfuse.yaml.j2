# secrets/.templates/services/langfuse.yaml.j2 – Langfuse LLM-observability stack secrets
# Encrypted to: oci-melb-1 (langfuse service host)
# Key path: secrets/services/langfuse.yaml
#
# Bootstrap: just secrets bootstrap secrets/services/langfuse.yaml
# Supply:    BOOTSTRAP_LANGFUSE_S3_ACCESS_KEY_ID — R2 access key id for the langfuse bucket.
# Supply:    BOOTSTRAP_LANGFUSE_S3_SECRET_ACCESS_KEY — R2 secret access key for the langfuse bucket.
# Supply:    BOOTSTRAP_INITIAL_ADMIN_EMAIL — must be a valid email address: the operator's Kanidm address, so the OIDC login lands on this admin account; langfuse refuses to start on an invalid value.
{% set clickhouse_password = secrets.token_hex(24) %}
database:
  password: "{{ secrets.token_hex(24) }}" # URL-safe (interpolated into the connection string)
clickhouse:
  password: "{{ clickhouse_password }}"
  password_sha256: "{{ hashlib.sha256(clickhouse_password.encode()).hexdigest() }}" # SHA-256 hex digest of the same plaintext
redis:
  password: "{{ secrets.token_hex(24) }}"
s3:
  access_key_id: "{{ environ.BOOTSTRAP_LANGFUSE_S3_ACCESS_KEY_ID | default('PLACEHOLDER') }}" # R2 access key id for the langfuse bucket
  secret_access_key: "{{ environ.BOOTSTRAP_LANGFUSE_S3_SECRET_ACCESS_KEY | default('PLACEHOLDER') }}" # R2 secret access key
encryption_key: "{{ secrets.token_hex(32) }}" # keep stable after first use
salt: "{{ secrets.token_hex(32) }}" # keep stable after first use
nextauth_secret: "{{ secrets.token_hex(32) }}" # keep stable after first use
initial_admin:
  email: "{{ environ.BOOTSTRAP_INITIAL_ADMIN_EMAIL | default('PLACEHOLDER') }}" # must be a valid email address: the operator's Kanidm address, so the OIDC login lands on this admin account; langfuse refuses to start on an invalid value
  password: "{{ secrets.token_hex(24) }}" # first-run admin password; rotate after first login
# First-run OTLP seed (LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY): Langfuse
# creates the org/project/keys at startup when these exist, and the collector's
# fan-out exporter authenticates with the SAME pair — so the credential is
# generated here once and consumed on both sides. `basic` is the HTTP Basic
# value base64(public:secret) that modules/flake/telemetry.nix sends.
{% set lf_pk = "pk-lf-" ~ secrets.token_hex(16) %}
{% set lf_sk = "sk-lf-" ~ secrets.token_hex(16) %}
otel:
  public_key: "{{ lf_pk }}"
  secret_key: "{{ lf_sk }}"
  basic: "{{ base64.b64encode((lf_pk ~ ':' ~ lf_sk).encode()).decode() }}"
