set shell := ["bash", "-euo", "pipefail", "-c"]
set no-cd

# The host is the edge host from lib/deploy/hosts.nix; the scripts resolve it
# themselves when no argument is given.
sync host="":
  @./scripts/export-web-services-policy.sh {{host}}
  @./tests/check-web-services-policy.sh {{host}}

_runtime:
    @PYTHONHASHSEED=random ./scripts/render-opentofu-cloudflare-runtime.sh

init: _runtime
    @tofu -chdir=opentofu/cloudflare init -reconfigure -backend-config=backend.hcl

plan: _runtime
    @tofu -chdir=opentofu/cloudflare init -reconfigure -backend-config=backend.hcl
    @tofu -chdir=opentofu/cloudflare plan

apply: _runtime
    @tofu -chdir=opentofu/cloudflare init -reconfigure -backend-config=backend.hcl
    @tofu -chdir=opentofu/cloudflare apply
