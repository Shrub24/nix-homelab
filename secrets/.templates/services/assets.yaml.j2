# secrets/.templates/services/assets.yaml.j2 – asset publishing credentials
# Encrypted to: oci-melb-1 (the only host that writes the bucket)
# Key path: secrets/services/assets.yaml
#
# Bootstrap: just secrets bootstrap secrets/services/assets.yaml
# Supply:    BOOTSTRAP_ASSETS_ACCESS_KEY_ID — Cloudflare R2 access key id
# Supply:    BOOTSTRAP_ASSETS_SECRET_ACCESS_KEY — Cloudflare R2 secret access key
# Supply:    BOOTSTRAP_ASSETS_CF_PURGE_TOKEN — Cloudflare API token with Zone Read and
#            Cache Purge on the zone (the zone is resolved from the domain, so no id is stored)
#
# The R2 token is scoped to the assets bucket with object read/write only: no account,
# bucket-administration or other-bucket authority. Objects are public by design, so nothing
# published from here may be secret.
access_key_id: "{{ environ.BOOTSTRAP_ASSETS_ACCESS_KEY_ID | default('PLACEHOLDER') }}"
secret_access_key: "{{ environ.BOOTSTRAP_ASSETS_SECRET_ACCESS_KEY | default('PLACEHOLDER') }}"
cf_purge_token: "{{ environ.BOOTSTRAP_ASSETS_CF_PURGE_TOKEN | default('PLACEHOLDER') }}"
