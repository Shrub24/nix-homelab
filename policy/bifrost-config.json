{
  "$schema": "https://www.getbifrost.ai/schema",
  "version": 2,
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "enable_logging": true
  },
  "providers": {
    "gemini": {
      "keys": [
        {
          "name": "gemini-primary",
          "value": "env.GEMINI_API_KEY",
          "weight": 1,
          "models": ["*"]
        }
      ]
    },
    "deepseek": {
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true
        }
      },
      "network_config": {
        "base_url": "https://api.deepseek.com"
      },
      "keys": [
        {
          "name": "deepseek-primary",
          "value": "env.DEEPSEEK_API_KEY",
          "weight": 1,
          "models": ["*"]
        }
      ]
    },
    "opencode-go": {
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true
        }
      },
      "network_config": {
        "base_url": "https://opencode.ai/zen/go/v1"
      },
      "keys": [
        {
          "name": "opencode-go-primary",
          "value": "env.OPENCODE_API_KEY",
          "weight": 1,
          "models": ["*"]
        }
      ]
    },
    "openrouter": {
      "keys": [
        {
          "name": "openrouter-primary",
          "value": "env.OPENROUTER_API_KEY",
          "weight": 1,
          "models": ["*"]
        }
      ]
    }
  },
  "governance": {
    "routing_rules": [
      {
        "id": "summariser",
        "name": "summariser",
        "priority": 10,
        "scope": "global",
        "cel_expression": "model == 'shrublab-text'",
        "fallbacks": ["opencode-go/mimo-v2.5"],
        "targets": [
          {
            "provider": "openrouter",
            "model": "xiaomi/mimo-v2.5",
            "weight": 1.0
          }
        ]
      },
      {
        "id": "image",
        "name": "image",
        "priority": 20,
        "scope": "global",
        "cel_expression": "model == 'shrublab-image'",
        "fallbacks": ["moonshotai/kimi-k2.6:free", "qwen/qwen3.5-flash-02-23"],
        "targets": [
          {
            "provider": "openrouter",
            "model": "xiaomi/mimo-v2.5",
            "weight": 1.0
          }
        ]
      },
      {
        "id": "embedding",
        "name": "embedding",
        "cel_expression": "model == 'shrublab-embedding'",
        "priority": 30,
        "scope": "global",
        "targets": [
          {
            "provider": "openrouter",
            "model": "qwen/qwen3-embedding-8b",
            "weight": 1.0
          }
        ]
      },
      {
        "id": "budget",
        "name": "budget",
        "priority": 40,
        "scope": "global",
        "cel_expression": "model == 'shrublab-fallback'",
        "fallbacks": ["deepseek/deepseek-v4-flash"],
        "targets": [
          {
            "provider": "opencode-go",
            "model": "deepseek-v4-flash",
            "weight": 1.0
          }
        ]
      }
    ]
  }
}
