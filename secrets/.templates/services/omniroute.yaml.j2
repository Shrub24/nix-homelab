# secrets/.templates/services/omniroute.yaml.j2 – OmniRoute LLM router bootstrap secrets
# Encrypted to: home-forge (omniroute service host)
# Key path: secrets/services/omniroute.yaml
#
# Bootstrap: just secrets bootstrap secrets/services/omniroute.yaml
omniroute:
  jwt_secret: "{{ secrets.token_hex(32) }}"
  api_key_secret: "{{ secrets.token_hex(32) }}"
  storage_encryption_key: "{{ secrets.token_hex(32) }}" # keep stable after first use
  initial_password: "{{ secrets.token_hex(24) }}" # dashboard admin bootstrap password
  ws_bridge_secret: "{{ secrets.token_hex(32) }}"
