{%- set user = (environ.BOOTSTRAP_DOCKERHUB_USERNAME | default('PLACEHOLDER')).strip(' \t\r\n') -%}
{%- set token = (environ.BOOTSTRAP_DOCKERHUB_TOKEN | default('PLACEHOLDER')).strip(' \t\r\n') -%}
{%- set clean = (user.encode() | length) == (user | length)
      and (token.encode() | length) == (token | length)
      and (token.split() | length) == 1 -%}
# secrets/.templates/services/containers.yaml.j2 – Docker Hub pull credential
# Encrypted to: owner + oci-melb-1 + home-forge (the hosts that run containers)
# Key path: secrets/services/containers.yaml
#
# Docker Hub rate-limits anonymous pulls per source address, and a limited pull has already
# broken a deploy. This is a personal access token with read-only scope, not a password:
# podman's auth file stores one opaque value, so the username is part of the same blob —
# base64 of `username:token`, which is why both are supplied here rather than a bare token.
#
# `services.containers.registryAuth` gates the wiring and defaults false, because sops fails
# evaluation on a missing file: the encrypted file has to exist before the flag is turned on.
# la-admin-1 runs no containers and is not a recipient.
#
# Rotate by replacing the token at hub.docker.com and re-running bootstrap; the rendered
# auth file is a sops template, so the next activation rewrites it.
#
# Bootstrap: just secrets bootstrap secrets/services/containers.yaml
# Supply:    BOOTSTRAP_DOCKERHUB_USERNAME — Docker Hub account name
# Supply:    BOOTSTRAP_DOCKERHUB_TOKEN — read-only personal access token for that account
dockerhub:
  auth: "{% if clean %}{{ base64.b64encode((user ~ ':' ~ token).encode()).decode() }}{% else %}{{ DOCKERHUB_CREDENTIAL_MUST_BE_PLAIN_ASCII_USER_COLON_PAT }}{% endif %}"
