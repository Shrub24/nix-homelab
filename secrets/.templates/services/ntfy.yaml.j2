# secrets/.templates/services/ntfy.yaml.j2 – ntfy server auth config block (la-admin-1 host)
# Encrypted to: owner, la-admin-1
# Decrypted as single file (key: "") and merged into server.yml via yq.
#
# The entire file content is the auth section of ntfy's config.
# Per-host identity model: each notification sender has its own user and token.
# The token value in auth-tokens must match the ntfy_token in that host's
# secrets/hosts/HOST/system.yaml (sent as Authorization: Bearer by the daemon).
#
# Values are produced as the operator (never paste hashes/tokens into this
# template):
#   1. For each user, generate a disposable random password and its bcrypt
#      hash locally:
#        ntfy user hash            # prompts for password, prints $2a$10$...
#      Token-only service accounts still require a real bcrypt hash in
#      auth-users: ntfy rejects `username::role` entries even though the user
#      never logs in with the password.
#   2. Generate each host's publish token locally:
#        ntfy token generate       # prints tk_ + 32 chars, for auth-tokens
#   3. The la-admin-1 token MUST equal ntfy_token in
#      secrets/hosts/la-admin-1/system.yaml.
#
# Bootstrap: just secrets bootstrap secrets/services/ntfy.yaml
# Supply:    BOOTSTRAP_NTFY_PASSWORD_HASH_SAURABHJ — bcrypt hash from `ntfy user hash` (admin role).
# Supply:    BOOTSTRAP_NTFY_PASSWORD_HASH_OCI_MELB_1 — disposable bcrypt hash from `ntfy user hash` (oci-melb-1, user role).
# Supply:    BOOTSTRAP_NTFY_PASSWORD_HASH_LA_ADMIN_1 — disposable bcrypt hash from `ntfy user hash` (la-admin-1, user role).
# Supply:    BOOTSTRAP_NTFY_PASSWORD_HASH_HOME_FORGE — disposable bcrypt hash from `ntfy user hash` (home-forge, user role).
# Supply:    BOOTSTRAP_NTFY_PASSWORD_HASH_LEGION — disposable bcrypt hash from `ntfy user hash` (legion, user role).
# Supply:    BOOTSTRAP_NTFY_PASSWORD_HASH_SPECTRE — disposable bcrypt hash from `ntfy user hash` (spectre, user role).
# Supply:    BOOTSTRAP_NTFY_TOKEN_OCI_MELB_1 — publish token from `ntfy token generate`; must equal ntfy_token in secrets/hosts/oci-melb-1/system.yaml.
# Supply:    BOOTSTRAP_NTFY_TOKEN_LA_ADMIN_1 — publish token from `ntfy token generate`; MUST equal ntfy_token in secrets/hosts/la-admin-1/system.yaml.
# Supply:    BOOTSTRAP_NTFY_TOKEN_HOME_FORGE — publish token from `ntfy token generate`; must equal ntfy_token in secrets/hosts/home-forge/system.yaml.
# Supply:    BOOTSTRAP_NTFY_TOKEN_LEGION — publish token from `ntfy token generate`; must equal the ntfy_token in legion's own secret store (it is not a fleet host).
# Supply:    BOOTSTRAP_NTFY_TOKEN_SPECTRE — publish token from `ntfy token generate`; must equal ntfy_token in secrets/hosts/spectre/system.yaml.
#
# auth-users: "USERNAME:BCRYPT_HASH:ROLE", the hash from `ntfy user hash`
#   - "saurabhj:$2a$10$hash:admin"
#   - "oci-melb-1:$2a$10$hash:user"
#   - "la-admin-1:$2a$10$hash:user"
#   - "home-forge:$2a$10$hash:user"
# auth-tokens: "USERNAME:TOKEN[:LABEL]", the token from `ntfy token generate`
#   - "oci-melb-1:tk_xxxxx:publish from oci-melb-1"
#   - "la-admin-1:tk_zzzzz:publish from la-admin-1"
#   - "home-forge:tk_yyyyy:publish from home-forge"
#
# ntfy ACLs match usernames, and publisher usernames are bare hostnames.
# ntfy documents the `auth-users`/`auth-tokens` spelling and also accepts the
# underscore variants; the push-server validator takes either, but a file that
# declares both forms of one key is rejected because ntfy's config loader would
# silently keep just one of them. Keep the documented spelling here.
auth_users:
  - "saurabhj:{{ environ.BOOTSTRAP_NTFY_PASSWORD_HASH_SAURABHJ | default('PLACEHOLDER') }}:admin"
  - "oci-melb-1:{{ environ.BOOTSTRAP_NTFY_PASSWORD_HASH_OCI_MELB_1 | default('PLACEHOLDER') }}:user"
  - "la-admin-1:{{ environ.BOOTSTRAP_NTFY_PASSWORD_HASH_LA_ADMIN_1 | default('PLACEHOLDER') }}:user"
  - "home-forge:{{ environ.BOOTSTRAP_NTFY_PASSWORD_HASH_HOME_FORGE | default('PLACEHOLDER') }}:user"
  - "legion:{{ environ.BOOTSTRAP_NTFY_PASSWORD_HASH_LEGION | default('PLACEHOLDER') }}:user"
  - "spectre:{{ environ.BOOTSTRAP_NTFY_PASSWORD_HASH_SPECTRE | default('PLACEHOLDER') }}:user"
auth_tokens:
  - "oci-melb-1:{{ environ.BOOTSTRAP_NTFY_TOKEN_OCI_MELB_1 | default('PLACEHOLDER') }}"
  - "la-admin-1:{{ environ.BOOTSTRAP_NTFY_TOKEN_LA_ADMIN_1 | default('PLACEHOLDER') }}"
  - "home-forge:{{ environ.BOOTSTRAP_NTFY_TOKEN_HOME_FORGE | default('PLACEHOLDER') }}"
  - "legion:{{ environ.BOOTSTRAP_NTFY_TOKEN_LEGION | default('PLACEHOLDER') }}"
  - "spectre:{{ environ.BOOTSTRAP_NTFY_TOKEN_SPECTRE | default('PLACEHOLDER') }}"
