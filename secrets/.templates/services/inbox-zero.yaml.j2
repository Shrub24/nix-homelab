# secrets/.templates/services/inbox-zero.yaml.j2 – Inbox Zero app-local secrets
# Encrypted to: oci-melb-1 (Inbox Zero host) and the owner
# Key path: secrets/services/inbox-zero.yaml
#
# Bootstrap: see docs/runbooks/inbox-zero.md for the Google resources to create first.
#   just secrets bootstrap secrets/services/inbox-zero.yaml
#
# Generated: the database password, auth and email-encryption material, the
# Pub/Sub verification token, the cron secret and the internal API key.
# Operator-issued: the Google OAuth client ID and secret are not generated, so they
# render empty and are filled afterwards by the operator in the SOPS editor,
# not in command arguments or shell history. Startup must reject empty credentials.
inbox-zero:
  database_password: "{{ secrets.token_hex(24) }}"
  auth_secret: "{{ secrets.token_hex(32) }}"
  email_encrypt_secret: "{{ secrets.token_hex(32) }}"
  email_encrypt_salt: "{{ secrets.token_hex(16) }}"
  pubsub_verification_token: "{{ secrets.token_hex(32) }}"
  cron_secret: "{{ secrets.token_hex(32) }}"
  internal_api_key: "{{ secrets.token_hex(32) }}"
  google_client_id: ""
  google_client_secret: ""
  google_pubsub_topic_name: "{{ environ.INBOX_ZERO_PUBSUB_TOPIC | default('') }}"
  auth_allowed_emails: "{{ environ.INBOX_ZERO_ALLOWED_EMAIL | default('') }}"
